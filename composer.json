{
    "name": "always-open/report-engine",
    "description": "General reporting engine for Laravel",
    "keywords": [
        "always-open",
        "laravel",
        "report-engine"
    ],
    "homepage": "https://github.com/always-open/report-engine",
    "license": "MIT",
    "authors": [
        {
            "name": "AlwaysOpen",
            "email": "qschmick@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2.0|^8.3.0|^8.4.0",
        "always-open/sidekick": "^5.0",
        "brick/money": "^0.10.0",
        "illuminate/contracts": "^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.19.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^v3.5",
        "nunomaduro/collision": "^v8.6",
        "orchestra/testbench": "^v9.11",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ray": "^1.39",
        "vimeo/psalm": "^6.8"
    },
    "autoload": {
        "psr-4": {
            "AlwaysOpen\\ReportEngine\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlwaysOpen\\ReportEngine\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "./vendor/bin/testbench package:test --no-coverage",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlwaysOpen\\ReportEngine\\ReportEngineServiceProvider"
            ],
            "aliases": {
                "ReportEngine": "AlwaysOpen\\ReportEngine\\ReportEngineFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
